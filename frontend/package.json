{
  "name": "ffxivshare-main-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "test": "vitest run",
    "check:design": "node scripts/check-design-system.mjs",
    "check:contrast": "node scripts/check-color-contrast.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "verify": "npm run test && npm run check:design && npm run check:contrast && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "htmx.org": "2.0.10"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
