APP_ENV=development
SECRET_KEY=django-insecure-local-development-only-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
TRUST_X_FORWARDED_FOR=False
RATE_LIMIT_ENABLED=True
CSP_REPORT_ONLY=True
RENDERER_PROXY_TIMEOUT_SECONDS=5
RENDERER_PROXY_MAX_BYTES=16777216
# Backend metadata lookup; matches the development /n/ proxy's remote renderer.
BOARD_RENDER_META_URL=https://ff14hub.com/n/render-meta
BOARD_RENDER_META_TIMEOUT_SECONDS=1
REQUEST_LOG_ENABLED=False

DATABASE_ENGINE=sqlite
DATABASE_PATH=db.sqlite3
MEDIA_ROOT=media
SQLITE_TIMEOUT=30
SQLITE_TRANSACTION_MODE=IMMEDIATE
SQLITE_JOURNAL_MODE=WAL
SQLITE_SYNCHRONOUS=FULL
