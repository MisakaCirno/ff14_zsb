APP_ENV=production
# Use the immutable deployed release identifier. Production-copy handoff
# rejects this placeholder, blank values, and "unknown".
APP_VERSION=replace-with-deployed-release-id
# Configure this in the service process environment, not inside this file:
# FFXIVSHARE_ENV_FILE=D:\FFXIVShareData\config\ffxivshare.env
# This placeholder is intentionally rejected until it is replaced.
SECRET_KEY=replace-me
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
# Only enable these after every subdomain is permanently HTTPS-only.
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Only enable while Waitress is loopback-only and the proxy replaces this header.
TRUST_X_FORWARDED_FOR=True
RATE_LIMIT_ENABLED=True
# Keep report-only until production responses have been reviewed for violations.
CSP_REPORT_ONLY=True
# Development proxy only; production Nginx keeps the existing /n/ renderer.
RENDERER_PROXY_TIMEOUT_SECONDS=5
RENDERER_PROXY_MAX_BYTES=16777216
REQUEST_LOG_ENABLED=True

# SQLite production defaults. Keep the database and backups on local NTFS,
# not on a network share. Set DATABASE_PATH to a persistent data directory.
DATABASE_ENGINE=sqlite
DATABASE_PATH=D:\FFXIVShareData\database\ffxivshare.sqlite3
MEDIA_ROOT=D:\FFXIVShareData\media
SQLITE_TIMEOUT=30
SQLITE_TRANSACTION_MODE=IMMEDIATE
SQLITE_JOURNAL_MODE=WAL
SQLITE_SYNCHRONOUS=FULL

# PostgreSQL alternative (install requirements-postgres.txt first):
# DATABASE_ENGINE=postgresql
# DATABASE_NAME=ffxivshare
# DATABASE_USER=ffxivshare
# DATABASE_PASSWORD=replace-me
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_CONN_MAX_AGE=60
# DATABASE_CONNECT_TIMEOUT=10
# DATABASE_SSLMODE=prefer
