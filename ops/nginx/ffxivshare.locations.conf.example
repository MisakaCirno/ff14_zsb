# Include this file inside the existing HTTPS server {} block.
# Keep TLS, the canonical hostname, and any site-wide security policy in the
# existing server configuration.
#
# RESERVED: /n/
# Keep the currently deployed /n/ renderer location in that server block
# unchanged. This include intentionally does not define /n/ or rewrite its URI.
# The renderer is outside the scope of this migration.

location ^~ /static/ {
    alias D:/FFXIVShareApp/current/staticfiles/;
    access_log off;
    log_not_found off;
    add_header X-Content-Type-Options "nosniff" always;
}

location ^~ /media/ {
    alias D:/FFXIVShareData/media/;
    access_log off;
    log_not_found off;
    add_header X-Content-Type-Options "nosniff" always;
}

# Exact health endpoints are available only to checks running on this host.
# Do not add an external address without reviewing the monitoring boundary.
location = /health/live/ {
    allow 127.0.0.1;
    allow ::1;
    deny all;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Request-ID "";
    proxy_pass http://127.0.0.1:8000;
}

location = /health/ready/ {
    allow 127.0.0.1;
    allow ::1;
    deny all;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Request-ID "";
    proxy_pass http://127.0.0.1:8000;
}

location / {
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Overwrite client-supplied forwarding data instead of appending it.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Request-ID "";

    proxy_connect_timeout 5s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    proxy_redirect off;
    proxy_pass http://127.0.0.1:8000;
}
