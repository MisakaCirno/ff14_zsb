# Include this file inside the existing ff14hub.com HTTPS server block.
# It is tailored to the current direct Git clone deployment on Windows.
#
# RESERVED: /n/
# Keep the existing exact /n redirect and /n/ renderer proxy unchanged. This
# include intentionally does not define /n/ or connect to the Bun renderer.

location ^~ /static/app/assets/ {
    alias C:/Users/Administrator/Desktop/srv/ff14_zsb/staticfiles/app/assets/;
    access_log off;
    log_not_found off;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header X-Content-Type-Options "nosniff" always;
}

location ^~ /static/ {
    alias C:/Users/Administrator/Desktop/srv/ff14_zsb/staticfiles/;
    access_log off;
    log_not_found off;
    add_header Cache-Control "public, max-age=3600" always;
    add_header X-Content-Type-Options "nosniff" always;
}

location ^~ /media/ {
    alias C:/Users/Administrator/Desktop/srv/ff14_zsb/media/;
    access_log off;
    log_not_found off;
    add_header X-Content-Type-Options "nosniff" always;
}

location = /health/live/ {
    allow 127.0.0.1;
    allow ::1;
    deny all;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Request-ID "";
    proxy_pass http://127.0.0.1:8000;
}

location = /health/ready/ {
    allow 127.0.0.1;
    allow ::1;
    deny all;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Request-ID "";
    proxy_pass http://127.0.0.1:8000;
}

location / {
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Replace, rather than append, all client-controlled forwarding metadata.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Request-ID "";

    proxy_connect_timeout 5s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    proxy_redirect off;
    proxy_pass http://127.0.0.1:8000;
}
